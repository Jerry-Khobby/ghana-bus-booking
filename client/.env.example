# Copy to .env.local to change these. Nothing here is secret: Vite puts
# VITE_* values into the browser bundle.

# Development: where `npm run dev` forwards /api. Leave unset for the
# deployed API (it has the demo data); a local one runs on port 3000.
# VITE_API_PROXY=http://localhost:3000

# Production build only: the API's address, when the web host does not
# forward /api to it. Leave unset if it does (recommended: one site, so the
# sign-in cookie is first-party everywhere, Safari included).
# VITE_API_URL=https://seatline-api-ls9x.onrender.com
