# Copy to .env. Docker Compose and Prisma both read it.

# Local Postgres container (docker compose up -d postgres)
POSTGRES_DB=seatline
POSTGRES_USER=seatline
POSTGRES_PASSWORD=seatline

# The app's connection. From your laptop the host is localhost; the api
# container overrides this to use the "postgres" host instead.
# In the cloud: Neon's pooled URL.
DATABASE_URL=postgresql://seatline:seatline@localhost:5432/seatline?schema=public

# Neon's direct (non-pooled) URL, used by Prisma for migrations.
# Leave unset locally; migrations fall back to DATABASE_URL.
# DIRECT_URL=

PORT=3000

# Optional: NestJS Observe (APM). Leave unset to run without it.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Password for every seeded staff account (10+ characters). Dev and demo only.
SEED_PASSWORD=seatline-demo-2026

# Payments run on Paystack test mode: use sk_test_/pk_test_ keys from the
# Paystack dashboard (Settings → API Keys). No real money moves. In test mode
# only 0551234987 is approved for mobile money; other numbers are declined.
# (Automated tests use PAYMENT_PROVIDER=fake and never call Paystack.)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Optional: where the card checkout sends the payer when they finish
# PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/return
